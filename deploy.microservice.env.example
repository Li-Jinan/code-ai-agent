MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
REDIS_PASSWORD=replace-with-a-strong-password

# Public URL used by the frontend and by generated app deployment links.
PUBLIC_BASE_URL=https://your-domain.com

# AI providers.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
PEXELS_API_KEY=

# Optional Tencent COS settings for screenshot cover uploads.
COS_CLIENT_HOST=
COS_CLIENT_SECRETID=
COS_CLIENT_SECRETKEY=
COS_CLIENT_REGION=
COS_CLIENT_BUCKET=

# Public ports. Keep 80 for a direct demo link, or change it if another reverse proxy owns 80/443.
HTTP_PUBLIC_PORT=80
MYSQL_PUBLIC_PORT=3306
REDIS_PUBLIC_PORT=6379
NACOS_PUBLIC_PORT=8848
USER_SERVICE_PUBLIC_PORT=8124
APP_SERVICE_PUBLIC_PORT=8125
SCREENSHOT_SERVICE_PUBLIC_PORT=8127

