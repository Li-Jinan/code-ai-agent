MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=code_ai_agent
MYSQL_USERNAME=root
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_HOST=redis
REDIS_PORT=6379

# Keep false when Compose starts its bundled MySQL/Redis. Set true only when
# an existing, pre-created Docker network supplies external infrastructure.
APP_NETWORK_NAME=code-ai-agent-network
APP_NETWORK_EXTERNAL=false

# Public URL used by the main frontend and unified API gateway.
PUBLIC_BASE_URL=https://your-domain.com

# Separate origin used only for AI-generated sites. Do not reuse PUBLIC_BASE_URL.
DEPLOY_BASE_URL=https://preview.your-domain.com

# Public interview account. The user-service recreates/repairs it at startup.
DEMO_ACCOUNT_ENABLED=true
DEMO_ACCOUNT_USERNAME=demo
DEMO_ACCOUNT_PASSWORD=demo123456
DEMO_ACCOUNT_DAILY_GENERATION_LIMIT=10

# Optional email provider used by user-service email login/password reset.
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# AI providers.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
PEXELS_API_KEY=

# Bounded AI generation capacity. Increase only after observing server CPU/RAM.
GENERATION_TASK_WORKER_COUNT=2
GENERATION_TASK_QUEUE_CAPACITY=8
GENERATION_TASK_TIMEOUT=10m

# Tencent COS settings required for screenshot cover uploads.
COS_CLIENT_HOST=https://your-bucket.cos.your-region.myqcloud.com
COS_CLIENT_SECRETID=replace-with-your-cos-secret-id
COS_CLIENT_SECRETKEY=replace-with-your-cos-secret-key
COS_CLIENT_REGION=replace-with-your-cos-region
COS_CLIENT_BUCKET=replace-with-your-cos-bucket

# Bind internal infrastructure/service ports to localhost by default.
# Change to 0.0.0.0 only for temporary remote debugging with a restricted security group.
INFRA_BIND_IP=127.0.0.1
SERVICE_BIND_IP=127.0.0.1

# Keep this on 127.0.0.1 while an ICP filing is under review or when a host
# Nginx owns the public 80/443 ports. Use 0.0.0.0 only for deliberate direct access.
WEB_BIND_IP=127.0.0.1

# Public ports. Keep 80 for a direct HTTP demo link, or change it if another reverse proxy owns 80/443.
HTTP_PUBLIC_PORT=18080
PREVIEW_PUBLIC_PORT=18081
MYSQL_PUBLIC_PORT=3306
REDIS_PUBLIC_PORT=6379
NACOS_PUBLIC_PORT=8848
NACOS_GRPC_PUBLIC_PORT=9848
USER_SERVICE_PUBLIC_PORT=8124
APP_SERVICE_PUBLIC_PORT=8125
SCREENSHOT_SERVICE_PUBLIC_PORT=8127
